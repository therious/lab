{
  "name": "simple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@therious/utils": "*",
    "@therious/boot": "*",
    "@fastify/static": "~7.0.4",
    "fastify": "~4.27.0",
    "reflect-metadata": "~0.1.13"
  },
  "devDependencies": {
    "typescript": "~5.4.5",
    "vite": "~5.2.8",
    "vite-plugin-node": "~3.1.0",
    "vite-plugin-static-copy": "~1.0.5"
  },
  "scripts": {
    "start": "VITE_CJS_IGNORE_WARNING=true vite",
    "secstart": "doppler run -- vite",
    "build": "vite build",
    "dbuild": "vite build  && pushd ../../dist/simple  && npx --yes @flydotio/dockerfile@latest --distroless --force && popd",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx,ts,tsx"
  },
  "browserslist": {
    "production": [
      "Chrome >= 112",
      "Edge >= 112",
      "Firefox >= 112",
      "Safari >= 16.4"
    ],
    "development": [
      "Chrome >= 112",
      "Edge >= 112",
      "Firefox >= 112",
      "Safari >= 16.4"
    ]
  }
}
