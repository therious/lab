# Firebase project config — get from Firebase Console → Project Settings → Your apps
# Copy this file to .env.local for local dev, or add these to Doppler (project: lab) for deployments.
# These are client-side public values (not secrets), but keeping them in Doppler is fine for consistency.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
