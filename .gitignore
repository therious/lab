# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp/
.pnp.js
.vite/
.angular/
# testing
coverage/
https/

# production
build/
dist/

# misc
.DS_Store

#prevent .env.*.local files from being checked in
*.local

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# generated indices (Note: scripts/library-index-generator.js parses this .gitIgnore to determine which files to generate!)
libs/actions/index.ts
libs/utils/index.ts
libs/fsm/index.ts
libs/ddd/index.ts
libs/ag-grid/index.ts
**/nohup.out

# docs folder may contain notes, works in progress, or files that are "dirty" with secrets
# keep these in ignored exclude folder to prevent commit
docs/exclude

# SpecStory AI interaction history (never commit - record in GitHub issues instead)
.specstory/
.specstory/**
**/.specstory/
**/.specstory/**
discussions/

# SQLite database files (runtime data, not source code)
**/*.db
**/*.db-shm
**/*.db-wal
servers/elections/priv/repo/*.db
servers/elections/priv/repo/*.db-shm
servers/elections/priv/repo/*.db-wal

# Built static files (generated from apps/elect build)
# Note: priv/elections/ (YAML configs) and priv/repo/migrations/ are source and should be tracked
servers/elections/priv/static/

# Build artifacts - generated at build time
**/build-info.json
**/src/build-info.json

# SWC compiler plugin cache (platform-specific WASM blobs, regenerated automatically)
**/.swc/

# favicon.io generator output folders (actual PNGs are in src/assets/)
**/favicon_io/

# Elixir/Phoenix dependencies (managed by Mix)
**/deps/
**/_build/

# API keys and credentials (never commit)
apps/anthropic/anthropic-key.txt
**/*key*.txt
docs/firebase.txt

# Generated by switch/to-npm.js — regenerate via `cd switch && npm run to-npm`, do not commit.
# pnpm reads package.yaml; npm reads package.json. Having both in the same directory breaks pnpm.
/package.json
/apps/*/package.json
/servers/*/package.json
/scripts/package.json
